<!--
  Runs Scripts/Logic through its paces WITHOUT Unity.

  Why this exists: `Unity.exe -batchmode -runTests` is refused on this machine
  ("No valid Unity Editor license found", exit 198), so Unity's own test runner cannot gate
  anything. Everything under Scripts/Logic is
  deliberately free of any using directive, so it compiles here and the same assertions can run in
  seconds with no editor, no licence and no human.

  The folder name ends with `~`, which is how Unity is told to ignore a directory: none of this is
  imported as an asset, compiled into the mod's assemblies, or packed into the bundle.

  No PackageReference on purpose — see logictest.ps1 for how the restore is kept inside this folder.
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>NoBreakZoneCheck</AssemblyName>
    <RootNamespace>NoBreakZone.LogicTests</RootNamespace>
    <!-- The Logic sources live outside this folder, so take nothing by default and list explicitly. -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <!-- Relative: this repository is checked out as Assets/NoBreakZone inside the SDK project, but
         nothing guarantees that folder name. -->
    <Compile Include="..\..\Scripts\Logic\*.cs" />
  </ItemGroup>

</Project>
